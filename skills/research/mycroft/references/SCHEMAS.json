{
  "TaskBrief": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "TaskBrief",
    "type": "object",
    "required": [
      "outcome",
      "constraints",
      "scope",
      "inputs",
      "components",
      "evidence_needs",
      "missing_information",
      "completion_criterion"
    ],
    "properties": {
      "outcome": {
        "type": "string",
        "minLength": 1
      },
      "constraints": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "scope": {
        "type": "string",
        "minLength": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "components": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "evidence_needs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "missing_information": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "completion_criterion": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "WorkerResult": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "WorkerResult",
    "type": "object",
    "required": [
      "task_id",
      "status",
      "answer",
      "covered_scope",
      "sources",
      "claims",
      "gaps",
      "checks"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "partial",
          "limit_exhausted",
          "access_blocked",
          "failed",
          "cancelled"
        ]
      },
      "answer": {
        "type": "string"
      },
      "covered_scope": {
        "type": "string"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "locator",
            "status"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "read",
                "partial",
                "unread",
                "unavailable"
              ]
            },
            "version_or_date": {
              "type": "string"
            },
            "capture_method": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          }
        }
      },
      "claims": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "claim_text",
            "evidence_status",
            "support"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "claim_text": {
              "type": "string",
              "minLength": 1
            },
            "evidence_status": {
              "type": "string",
              "enum": [
                "observation",
                "source_assertion",
                "inference",
                "disputed"
              ]
            },
            "support": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "source_id",
                  "locator",
                  "exact_quote"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exact_quote": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "derivation": {
              "type": "string"
            },
            "qualifications": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "gaps": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "next_enquiry": {
        "type": [
          "string",
          "null"
        ]
      },
      "observed_usage": {
        "type": [
          "object",
          "null"
        ]
      }
    }
  },
  "CriticVerdict": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "CriticVerdict",
    "type": "object",
    "required": [
      "verdict",
      "review_mode",
      "covered_scope",
      "issues",
      "conditions",
      "quarantined_claims"
    ],
    "properties": {
      "verdict": {
        "type": "string",
        "enum": [
          "PASS",
          "FAIL",
          "ADMIT_WITH_CONDITIONS"
        ]
      },
      "review_mode": {
        "type": "string",
        "enum": [
          "independent",
          "self_review"
        ]
      },
      "covered_scope": {
        "type": "string"
      },
      "issues": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "target_task",
            "claim_ids",
            "severity",
            "defect",
            "remedy",
            "source_locators"
          ],
          "properties": {
            "target_task": {
              "type": "string"
            },
            "claim_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "severity": {
              "type": "string",
              "enum": [
                "MATERIAL",
                "MINOR"
              ]
            },
            "defect": {
              "type": "string"
            },
            "remedy": {
              "type": "string"
            },
            "source_locators": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "conditions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "quarantined_claims": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "claim_id",
            "reason"
          ],
          "properties": {
            "claim_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
